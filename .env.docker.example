# Laravel runtime settings, supplied to app/worker/scheduler by Compose env_file.
APP_NAME="Regray Studio"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# Generate with: docker run --rm --entrypoint php regray-studio-app:local artisan key:generate --show
# Paste the base64:... output here in your private .env.docker, not in this example.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
# Also read by Compose to initialize Postgres; pass --env-file .env.docker.
DB_DATABASE=regray
DB_USERNAME=regray
DB_PASSWORD=secret

# Real-time messaging. The app publishes to Reverb over the internal network
# (reverb:8080); browsers connect through Caddy on the public host.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SESSION_DRIVER=database

# Cache and queues. `database` needs nothing else. To move both to Redis (the
# `redis` service runs Valkey, which speaks the same protocol):
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis
#   REDIS_HOST=redis
# and set COMPOSE_PROFILES=redis below so Compose starts the redis service.
# The worker then runs Horizon (dashboard at /horizon, owner and admin only)
# instead of queue:work. Without REDIS_HOST, `redis` falls back to `database`.
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
# REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
# Horizon's worker processes in production; the worker container has 256 MB.
# HORIZON_MAX_PROCESSES=3

# Who may set X-Forwarded-For / X-Forwarded-Proto: comma-separated IPs or
# CIDRs. Leave empty while Caddy is the public edge: it talks FastCGI to PHP,
# so the client's own address is already REMOTE_ADDR. Name a load balancer or
# CDN here only if one is put in front of Caddy (Caddy then needs its own
# trusted_proxies too). Never `*`.
TRUSTED_PROXIES=

# Error reporting. Leave empty to turn Sentry off. Only the user's id and role
# are sent, never their email, name, IP or request bodies.
SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# Performance tracing is off unless a rate is set, e.g. 0.1 for 10%.
# SENTRY_TRACES_SAMPLE_RATE=

# Pulse (dashboard at /pulse, owner and admin only), stored in the app database.
PULSE_ENABLED=true
# Requests and queries slower than these (ms) are listed on the dashboard.
# PULSE_SLOW_REQUESTS_THRESHOLD=500
# PULSE_SLOW_QUERIES_THRESHOLD=100
# PULSE_SLOW_JOBS_THRESHOLD=1000

# Rate limits per minute, per signed-in user (per IP for a guest). Defaults in
# config/rate-limits.php; override any of them here.
# RATE_LIMIT_INQUIRY_SUBMIT=5
# RATE_LIMIT_INQUIRY_EDIT=10
# RATE_LIMIT_BOOKING=10
# RATE_LIMIT_SAVED_STONE=60
# RATE_LIMIT_GROUP_CREATE=10
# RATE_LIMIT_HEAVY_READS=120
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_PASSWORD_RESET=5
# RATE_LIMIT_MESSAGES=60
# RATE_LIMIT_MESSAGE_RECEIPTS=120
# RATE_LIMIT_MESSAGE_ASSIGNMENT=10
# RATE_LIMIT_MESSAGE_PEOPLE=60
# RATE_LIMIT_MESSAGE_ATTACHMENTS=300
# The limits count in the cache store; keep it on Redis in production, since
# on `database` every limited request adds writes to Postgres
# (load/RESULTS.md).

FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DISK=public
FILESYSTEM_PRIVATE_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
INERTIA_SSR_ENABLED=false

# Compose-only settings (Laravel does not read these).
# --env-file is required: service env_file does not supply Compose interpolation.
APP_DOMAIN=:80
WEB_HTTP_PORT=8080
# WEB_HTTPS_PORT=443
# APP_ENV_FILE=.env.docker
# APP_IMAGE=regray-studio-app:local
# WEB_IMAGE=regray-studio-web:local
# Starts the redis service; pair it with REDIS_HOST=redis above.
# COMPOSE_PROFILES=redis

# Public build-time settings, never secrets.
VITE_ASSET_URL=
VITE_APP_NAME="${APP_NAME}"
# Where the browser reaches Reverb. The page is told at runtime (the shared
# `realtime` prop); leave these empty to use the page's own host and port,
# which is right behind Caddy since it proxies /app/* to reverb:8080.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=
# Build-time fallbacks, read only when the REVERB_CLIENT_* values are unset.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
