<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Core: the tests CI runs on every pull request and before a deploy
            (`composer ci:check`). Sign-in, permissions, the inquiry, quote,
            schedule and messaging flows, the schema, and the ops commands.
            Everything else still runs locally with `php artisan test` or
            `composer ci:full`. Not part of the default run, so nothing runs twice.
        -->
        <testsuite name="Core">
            <directory>tests/Unit</directory>
            <file>tests/Feature/Account/AccountSignInTest.php</file>
            <file>tests/Feature/Account/AccountStatusTest.php</file>
            <file>tests/Feature/Account/PasswordChangeTest.php</file>
            <file>tests/Feature/Auth/GoogleSignInTest.php</file>
            <file>tests/Feature/Auth/RegistrationConsentTest.php</file>
            <file>tests/Feature/BackupDatabaseCommandTest.php</file>
            <file>tests/Feature/Database/SchemaTest.php</file>
            <file>tests/Feature/HealthCheckCommandTest.php</file>
            <file>tests/Feature/Inquiry/CreateInquiryActionTest.php</file>
            <file>tests/Feature/Inquiry/CreateInquiryEndToEndTest.php</file>
            <file>tests/Feature/Inquiry/InquiryControllerTest.php</file>
            <file>tests/Feature/Inquiry/InquiryFulfillmentTest.php</file>
            <file>tests/Feature/Inquiry/InquiryVisibilityTest.php</file>
            <file>tests/Feature/Inquiry/StoreInquiryRequestTest.php</file>
            <file>tests/Feature/Inquiry/WalkInOwnershipTest.php</file>
            <file>tests/Feature/Message/BroadcastChannelsTest.php</file>
            <file>tests/Feature/Message/ConversationPolicyTest.php</file>
            <file>tests/Feature/Message/MessageAttachmentsTest.php</file>
            <file>tests/Feature/Message/RealtimeAccessTest.php</file>
            <file>tests/Feature/PermissionMatrixTest.php</file>
            <file>tests/Feature/ProxyTest.php</file>
            <file>tests/Feature/Quote/InquiryFileTest.php</file>
            <file>tests/Feature/Quote/QuoteActionsTest.php</file>
            <file>tests/Feature/Quote/QuoteCancelTest.php</file>
            <file>tests/Feature/Quote/QuoteEditTest.php</file>
            <file>tests/Feature/RateLimitsTest.php</file>
            <file>tests/Feature/Schedule/BookingStoreTest.php</file>
            <file>tests/Feature/Schedule/ScheduleChangeTest.php</file>
            <file>tests/Feature/Schedule/ScheduleVisibilityTest.php</file>
            <file>tests/Feature/ScheduleTest.php</file>
            <file>tests/Feature/Settings/AccountDeletionTest.php</file>
            <file>tests/Feature/Settings/SecurityTest.php</file>
            <file>tests/Feature/SuperAdminAccessTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against Postgres, the same engine the app develops on, so
            a schema that works here works on a laptop and in CI alike.

            DB_DATABASE is deliberately NOT the application's database. The
            Feature suite uses RefreshDatabase, which runs migrate:fresh and
            would therefore drop every table in whatever it points at. This
            database exists only to be thrown away. It does not need to be
            created by hand: migrate:fresh delegates to a forced migrate, which
            creates a missing Postgres database on the way in.

            The values below are the ones from .env.example, so a local run
            needs nothing beyond a running Postgres. CI provisions the same
            engine, version, user and port.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="regray-test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
