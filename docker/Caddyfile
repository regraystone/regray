{$APP_DOMAIN} {
	root * /var/www/html/public
	encode zstd gzip

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# Browsers ignore this over plain HTTP, so it is safe on a local :80 stack.
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Report-only: violations show in the browser console and nothing is
		# blocked. Rename it to Content-Security-Policy once it reports none.
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https:"
		-Server
	}

	# Reverb's WebSocket endpoint for the Message page.
	@reverb path /app/*
	reverse_proxy @reverb reverb:8080

	php_fastcgi app:9000
	file_server
}
