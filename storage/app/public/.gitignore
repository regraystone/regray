*
!.gitignore

# The stone catalogue photographs are content, not runtime uploads, so they are
# committed and served straight from storage/app/public/stones/.
!stones/
!stones/**

# The project photographs are content, not runtime uploads, so they are
# committed and served straight from storage/app/public/projects/.
!projects/
!projects/**

# The brand logos and thumbnails are content, not runtime uploads, so they are
# committed and served straight from storage/app/public/brands/.
!brands/
!brands/*

# The furniture photographs are content, not runtime uploads, so they are
# committed and served straight from storage/app/public/furniture/.
!furniture/
!furniture/**
